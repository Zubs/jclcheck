{
  "name": "jclcheck",
  "version": "1.0.0",
  "private": true,
  "description": "The JCLcheck validator (lexer, parser, rules, formatter) and the jclcheck command. No dependencies.",
  "main": "src/index.js",
  "bin": {
    "jclcheck": "bin/jclcheck.js"
  },
  "files": [
    "src",
    "bin"
