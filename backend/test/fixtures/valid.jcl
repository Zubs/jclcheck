//PAYROLL  JOB (ACCT123),'J SMITH',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//STEP010  EXEC PGM=IEFBR14
//DD1      DD   DSN=PROD.PAYROLL.INPUT,DISP=SHR
//DD2      DD   DSN=PROD.PAYROLL.OUTPUT,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,5),RLSE),
//             UNIT=SYSDA,
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//STEP020  EXEC PGM=SORT,COND=(4,LT,STEP010)
//SORTIN   DD   DSN=PROD.PAYROLL.OUTPUT,DISP=SHR
//SORTOUT  DD   DSN=PROD.PAYROLL.SORTED,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,5)),UNIT=SYSDA
//SYSOUT   DD   SYSOUT=*
//SYSIN    DD   *
  SORT FIELDS=(1,10,CH,A)
/*
